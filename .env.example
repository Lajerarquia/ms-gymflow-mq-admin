# Copia este archivo como .env y completa los valores. El .env NO se sube al repositorio.
# RabbitMQ (clúster de 2 nodos en ec2-mq): IP privada de ec2-mq.
RABBITMQ_ADDRESSES=<ip-privada-ec2-mq>:5672,<ip-privada-ec2-mq>:5673
RABBITMQ_USERNAME=gymflow
RABBITMQ_PASSWORD=<contraseña>
# API de Management (puerto 15672 de rabbit1). El security group de ec2-mq debe permitirlo desde ec2-apps.
RABBITMQ_MANAGEMENT_URL=http://<ip-privada-ec2-mq>:15672
